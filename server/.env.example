# Copie este arquivo para ".env" (na pasta server/) e preencha. O ".env" nunca vai para o GitHub.

# --- Rodando no seu computador com XAMPP (padrão) ---
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=robolab

